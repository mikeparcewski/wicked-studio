---
/**
 * index.astro — the wicked-studio landing page (ws.wickedagile.com).
 *
 * POSITIONING: studio is the IDE for running a team of coding agents. The page leads with that and
 * shows it: the hero IS a working miniature of the Desk (sessions on the left, a run as a chat in
 * the middle, what changed on the right). Separate-agent review is a supporting proof further down,
 * not the hook.
 *
 * Shape: hook → the working demo → four short proofs (the Desk, review + receipt, rules / memory /
 * knowledge, agents + projects) → the family map → get it. One voice: plain words, second person,
 * no paragraph past ~3 lines.
 *
 * ACCURACY (studio 0.10.1 / crew 0.14.1). Every label in the demo is a real studio label:
 *  - A run's page is a chat: your messages right-aligned, each agent's turn under its name, the
 *    plan card's "Approve plan" / "Not now", one "Working on Build…" line, and the final message
 *    "Done. Tests pass (38), and codex reviewed and approved it. Pull request #12 is open." with
 *    the pull request, Changes and Evidence as chips (CHANGELOG 0.10.0).
 *  - Gate choices: "Approve", "Approve with a note for the next step", "Send back"
 *    (src/components/session/GateRow.tsx, gateMoveModel.ts).
 *  - A question card names the agent that asked (0.9.3). "Needs you" is the inbox (0.10.0).
 *  - Desk tabs = DESK_TABS in src/components/desk/DeskV2.tsx.
 *  - Review on the builder's own agent is refused unless the job is launched with reduced
 *    assurance, labelled on the run, every gate and the delivery (crew 0.9.0 / core-ts 0.7.46).
 *  - The assurance receipt: required vs ran, who built / reviewed / judged, what was skipped.
 *  - QE acceptance is required for feature / bug / migration / mcp-server runs.
 *  - Studio grades nothing: the checks are crew's, the store is estate's. Studio is a pure client
 *    of crew's /api/v1 + /ws; the wire contract wicked-crew-api-types is the only shared code.
 * Never hardcode a version in prose: the install stamp is injected at build time (DT-7).
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import SameGarden from 'wicked-web/components/SameGarden.astro';
import '../styles/studio.css';

// The hook. Kept as two strings so the operator can swap a variant in one place.
const HEADLINE = 'The IDE for running a team of coding agents.';
const SUBLINE = 'Chat with them, watch the work happen, make the calls only you can make, and ship what they changed.';

const title = 'wicked-studio — the IDE for running a team of coding agents';
// What search results and social cards show. Same attribution boundary as the page: the crew
// daemon runs the agents; studio is the screen you run them from.
const description =
  'The IDE for running a team of coding agents. Chat with Claude Code, Codex, Copilot, OpenCode and Pi, watch the work happen live, answer the gates that need you, and approve what changed. A different agent reviews every change, and the wicked-crew daemon on your machine runs each agent in a sandbox.';
const repo = 'https://github.com/mikeparcewski/wicked-studio';

// The Desk's real tabs (DESK_TABS in src/components/desk/DeskV2.tsx), one plain line each.
const TABS = [
  { name: 'Work', line: 'What needs you first, then what is running. Start a new job here.' },
  { name: 'Runs', line: 'Every job as one chat: the live record and the gates you answer.' },
  { name: 'Repositories', line: 'Your repos, their onboarding and their code graphs.' },
  { name: 'Report', line: 'What your agents did lately: outcomes and spend, by project.' },
  { name: 'Understand', line: 'Compare jobs, repos or agents side by side.' },
  { name: 'Steer', line: 'Your rules, each scoped to everywhere, one project or one repo.' },
  { name: 'Memory', line: 'What happened and what you told it. Edit or erase any of it.' },
  { name: 'Agents', line: 'Sign each agent in once. It runs in a sandbox.' },
  { name: 'Evaluate', line: 'Test your rules against examples before they check real work.' },
];

const AGENTS = ['Claude Code', 'Codex', 'Copilot', 'OpenCode', 'Pi'];

// Injected at build time from the repo's package.json via astro.config.mjs (DT-7).
const studioVersion = __WICKED_STUDIO_VERSION__;
---

<Base title={title} description={description} favicon="/favicon.svg">
  <Topbar pkg="wicked-studio" repo={repo} />

  <!-- ── Hook + the working demo ─────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="amber-floor" aria-hidden="true"></div>
    <div class="wrap hero-head">
      <h1 id="hero-h">{HEADLINE}</h1>
      <p class="lede">{SUBLINE}</p>
    </div>

    <div class="wrap">
      <!-- A working miniature of the Desk. Left: your sessions. Middle: the selected run as a chat.
           Right: what changed, and the run's receipt. Scripted, not live: it never calls a daemon. -->
      <div class="ide" data-ide aria-label="A working demo of wicked-studio: three jobs, one of them yours to drive">
        <div class="ide-bar">
          <span class="ide-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <nav class="ide-tabs" aria-label="Desk tabs (illustration)">
            <span class="is-on">Work</span><span>Runs</span><span>Repositories</span><span>Steer</span><span>Memory</span><span>Agents</span>
          </nav>
          <span class="ide-url" data-demo-note>scripted demo · press Send, then make the calls</span>
        </div>

        <div class="ide-body">
          <aside class="ide-rail" aria-label="Your jobs">
            <button type="button" class="ide-new" data-act="restart">+ New job</button>
            <p class="ide-rail-k">Needs you <span class="ide-count" data-needs>1</span></p>
            <div class="ide-sessions" role="tablist" aria-label="Jobs" data-sessions></div>
          </aside>

          <div class="ide-main">
            <div class="ide-head">
              <span class="ide-title" data-title>Rate limits for the public API</span>
              <ol class="ide-steps" data-steps aria-label="Steps"></ol>
            </div>
            <div class="ide-thread" data-thread role="log" aria-live="polite" aria-label="The job's conversation"></div>
            <form class="ide-composer" data-composer>
              <input type="text" data-input aria-label="Message your agents" placeholder="Message your agents…" autocomplete="off" spellcheck="false"
                     value="Add rate limiting to the public API: 100 requests a minute per API key." />
              <button type="submit" class="ide-send" data-send>Send</button>
            </form>
          </div>

          <aside class="ide-pane" aria-label="What changed">
            <div class="ide-pane-tabs" role="tablist" aria-label="Side panel">
              <button type="button" role="tab" class="is-on" aria-selected="true" data-pane-tab="changes">Changes <span class="ide-count ide-count--quiet" data-files>0</span></button>
              <button type="button" role="tab" aria-selected="false" data-pane-tab="receipt">Receipt</button>
            </div>
            <div class="ide-pane-body" data-pane></div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Proof 1: the Desk ──────────────────────────────────────────────── -->
  <section class="desk" aria-labelledby="desk-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="desk-h">One Desk for every agent and every repo.</h2>
        <p class="sec-sub">Launch jobs across your projects and let them run. When one needs a decision, it comes to you.</p>
      </div>
      <ul class="tab-grid" role="list">
        {TABS.map((t) => (
          <li class="tab-tile"><b>{t.name}</b><span>{t.line}</span></li>
        ))}
      </ul>
      <ul class="extras" role="list">
        <li>⌘K command palette</li>
        <li>Batch triage from the keyboard</li>
        <li>Desktop alerts when a job needs you</li>
        <li>Light and dark themes</li>
      </ul>
    </div>
  </section>

  <!-- ── Proof 2: review on a different agent, and the receipt ─────────── -->
  <section class="review" aria-labelledby="review-h">
    <div class="wrap review-grid">
      <div>
        <div class="sec-head">
          <h2 id="review-h">A different agent checks the work.</h2>
          <p class="sec-sub">The agent that built a change never approves it. Every gate shows its receipt.</p>
        </div>
        <ol class="flow" aria-label="Who does what on a job">
          <li><span class="flow-who">Builder</span><span class="flow-what">Claude Code writes the change in its sandbox</span></li>
          <li><span class="flow-who">Reviewer</span><span class="flow-what">Codex checks it, and can send it back</span></li>
          <li><span class="flow-who flow-who--you">You</span><span class="flow-what">approve, add a note, or send it back</span></li>
        </ol>
        <ul class="facts" role="list">
          <li>Only one agent signed in? The job stops and says why, unless you launch it with <b>reduced assurance</b>, labelled everywhere.</li>
          <li>Features, bug fixes and migrations need <b>QE acceptance</b> before they ship, unless the change scores as trivial. You can skip it, with a reason on the record.</li>
          <li>The checks are <a href="https://wc.wickedagile.com">crew’s</a>. Studio shows them and never grades anything.</li>
        </ul>
      </div>
      <figure class="receipt" aria-label="An example assurance receipt">
        <figcaption>Receipt · job r-7c19 · build step</figcaption>
        <table>
          <tbody>
            <tr><th scope="row">Required</th><td>tests pass, a different agent reviews, QE acceptance</td></tr>
            <tr><th scope="row">Ran</th><td>tests (38 pass), review, QE acceptance</td></tr>
            <tr><th scope="row">Built by</th><td>Claude Code</td></tr>
            <tr><th scope="row">Reviewed by</th><td>Codex <span class="ok">separate agent</span></td></tr>
            <tr><th scope="row">Skipped</th><td>nothing</td></tr>
          </tbody>
        </table>
        <p class="receipt-foot">“Passed checks, nobody reviewed it” never reads like “independently accepted”.</p>
      </figure>
    </div>
  </section>

  <!-- ── Proof 3: rules, memory, knowledge ─────────────────────────────── -->
  <section class="steer" aria-labelledby="steer-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="steer-h">Rules you set. Memory you can edit. Knowledge it learned.</h2>
        <p class="sec-sub">Three different things, kept apart. Agents suggest; you approve.</p>
      </div>
      <div class="trio">
        <div class="trio-card">
          <h3>Rules</h3>
          <p>What a gate checks. Each rule reaches everywhere, one project or one repo.</p>
          <span class="trio-where">Steer tab</span>
        </div>
        <div class="trio-card">
          <h3>Memory</h3>
          <p>What happened and what you told it. See, edit or erase any of it.</p>
          <span class="trio-where">Memory tab</span>
        </div>
        <div class="trio-card">
          <h3>Knowledge</h3>
          <p>Learned from your code and docs, cited back to the source.</p>
          <span class="trio-where">kept by <a href="https://we.wickedagile.com">wicked-estate</a></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Proof 4: your agents, sandboxed; your repos, one context ───────── -->
  <section class="reach" aria-labelledby="reach-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="reach-h">Your agents, sandboxed. Your repos, one project.</h2>
      </div>
      <div class="reach-grid">
        <div class="reach-card">
          <h3>Bring the agents you already use</h3>
          <ul class="agent-chips" role="list">
            {AGENTS.map((a) => <li>{a}</li>)}
          </ul>
          <p>Sign each one in once on the Agents tab. Jobs run them in containers; credentials stay in a broker, and the sandbox only sees placeholders.</p>
        </div>
        <div class="reach-card">
          <h3>A project spans repos</h3>
          <p>Attach repos to a project and its jobs search one code graph over all of them.</p>
          <table class="hits" aria-label="One search across three repos">
            <caption><code>register</code> across one project: 8 hits</caption>
            <tbody>
              <tr><th scope="row">wicked-core</th><td>4</td><td>Rust</td></tr>
              <tr><th scope="row">wicked-crew</th><td>3</td><td>TypeScript</td></tr>
              <tr><th scope="row">wicked-studio</th><td>1</td><td>TypeScript</td></tr>
            </tbody>
          </table>
          <p class="reach-limit">Each hit names its repo. Calls between repos are not traced, and every answer says so.</p>
        </div>
      </div>
    </div>
  </section>

  <SameGarden current="wicked-studio" />

  <!-- ── Get it ───────────────────────────────────────────────────────────── -->
  <div class="finale">
    <section class="get" id="get">
      <div class="wrap get-grid">
        <div class="get-intro">
          <h2>One command. Studio comes with it.</h2>
          <p>
            <code>npx wicked-crew serve</code> starts the daemon and serves studio on one port. Open the
            URL it prints, sign in your agents, and start a job.
          </p>
          <ul class="needs" role="list">
            <li>Node 22 or later</li>
            <li>A container runtime: Docker, Podman, Rancher Desktop, Colima or OrbStack</li>
            <li>The whole family instead? <code>npx wicked-installer</code></li>
          </ul>
        </div>
        <div class="install-stack">
          <div class="install install--primary" role="group" aria-label="Run studio bundled with wicked-crew">
            <div class="install__bar">
              <span class="install__label"><span class="install__star" aria-hidden="true">★</span> Recommended</span>
              <button class="install__copy" type="button" aria-label="Copy the bundled serve command"
                onclick="navigator.clipboard&&navigator.clipboard.writeText('npx wicked-crew serve').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
            </div>
            <pre class="install__code"><code>npx wicked-crew serve</code></pre>
            <p class="install__note">Daemon and studio, one port. <span class="install__ver">wicked-studio v{studioVersion}</span></p>
          </div>

          <div class="install install--secondary" role="group" aria-label="Run wicked-studio standalone against a daemon">
            <div class="install__bar">
              <span class="install__label">Or host studio yourself</span>
              <button class="install__copy" type="button" aria-label="Copy the standalone build commands"
                onclick="navigator.clipboard&&navigator.clipboard.writeText('VITE_API_HOST=127.0.0.1:7701 npm run build\nnpx serve dist').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
            </div>
            <pre class="install__code"><code>VITE_API_HOST=127.0.0.1:7701 npm run build
npx serve dist</code></pre>
            <p class="install__note">Studio is a pure client of crew’s <code>/api/v1</code> and <code>/ws</code>. It shares no code with crew beyond the published contract, <code>wicked-crew-api-types</code>.</p>
          </div>
        </div>
        <a class="gh-pill" href="https://github.com/mikeparcewski/wicked-studio#readme" target="_blank" rel="noopener" aria-label="View wicked-studio on GitHub">
          <svg viewBox="0 0 16 16" width="42" height="42" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </section>

    <Footer repo={repo} />
  </div>

  <!-- ── The demo: three jobs, model-driven. Every render reads the model; timers only append. ── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-ide]');
      if (!root) return;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var $ = function (s) { return root.querySelector(s); };
      var threadEl = $('[data-thread]'), stepsEl = $('[data-steps]'), titleEl = $('[data-title]');
      var sessionsEl = $('[data-sessions]'), paneEl = $('[data-pane]'), needsEl = $('[data-needs]');
      var filesEl = $('[data-files]'), form = $('[data-composer]'), input = $('[data-input]');
      var STEPS = ['Plan', 'Build', 'Review', 'Test', 'Deliver'];
      var PROMPT = input.value;

      function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

      // ── the model ───────────────────────────────────────────────────────
      var FILES_V1 = [
        { path: 'src/http/rateLimit.ts', add: 41, del: 0, diff: [
          ['+', 'export function rateLimit(opts: { perMinute: number }) {'],
          ['+', '  const buckets = new Map<string, Bucket>();'],
          ['+', '  return (req, res, next) => {'],
          ['+', '    const key = req.ip;'],
          ['+', '    if (!take(buckets, key, opts.perMinute)) return res.status(429).end();'] ] },
        { path: 'src/http/router.ts', add: 3, del: 1, diff: [
          [' ', "import { publicRoutes } from './public';"],
          ['-', "app.use('/v1', publicRoutes);"],
          ['+', "app.use('/v1', rateLimit({ perMinute: 100 }), publicRoutes);"] ] },
        { path: 'test/rateLimit.test.ts', add: 28, del: 0, diff: [
          ['+', "it('returns 429 after 100 requests in a minute', async () => {"],
          ['+', '  await hit(100);'],
          ['+', '  expect((await hit(1)).status).toBe(429);'] ] }
      ];
      var FILES_V2 = FILES_V1.map(function (f) { return f; });
      FILES_V2[0] = { path: 'src/http/rateLimit.ts', add: 44, del: 0, diff: [
        ['+', 'export function rateLimit(opts: { perMinute: number }) {'],
        ['+', '  const buckets = new Map<string, Bucket>();'],
        ['+', '  return (req, res, next) => {'],
        ['+', "    const key = req.header('x-api-key') ?? req.ip;"],
        ['+', '    if (!take(buckets, key, opts.perMinute)) return res.status(429).end();'] ] };
      FILES_V2[2] = { path: 'test/rateLimit.test.ts', add: 39, del: 0, diff: [
        ['+', "it('limits each API key on its own', async () => {"],
        ['+', "  await hit(100, { key: 'a' });"],
        ['+', "  expect((await hit(1, { key: 'b' })).status).toBe(200);"] ] };

      function fresh() {
        return {
          rate: { title: 'Rate limits for the public API', who: 'Claude Code', state: 'draft', steps: 0, msgs: [], files: [], openFile: 0, receipt: null },
          flaky: { title: 'Fix the flaky checkout test', who: 'Codex', state: 'ask', steps: 1, msgs: [
            { k: 'user', t: 'The checkout test fails about once a week. Find out why and fix it.' },
            { k: 'agent', who: 'Codex', t: 'Found it: the test reads the real clock, so it fails whenever a run crosses midnight UTC.' },
            { k: 'ask', who: 'Codex', q: 'Freeze the clock in the test, or pass a clock into the checkout service?', opts: ['Freeze it in the test', 'Pass a clock in'], ans: null }
          ], files: [], openFile: 0, receipt: null },
          node: { title: 'Move CI to Node 22', who: 'Copilot', state: 'done', steps: 5, msgs: [
            { k: 'user', t: 'Move CI and the engines field to Node 22.' },
            { k: 'agent', who: 'Copilot', t: 'Updated the CI matrix and the engines field. Nothing else needed changing.' },
            { k: 'agent', who: 'Copilot', done: true, t: 'Done. Tests pass (212), and claude reviewed and approved it. Pull request #9 is open.', chips: ['Pull request #9', 'Changes', 'Evidence'] }
          ], files: [
            { path: '.github/workflows/ci.yml', add: 1, del: 1, diff: [['-', '        node: [20]'], ['+', '        node: [22]']] },
            { path: 'package.json', add: 1, del: 1, diff: [['-', '    "node": ">=20"'], ['+', '    "node": ">=22"']] }
          ], openFile: 0, receipt: { built: 'Copilot', reviewed: 'Claude Code', tests: '212 pass', decision: 'approved by the reviewer' } }
        };
      }
      var S = fresh();
      var ORDER = ['rate', 'flaky', 'node'];
      var cur = 'rate';
      var pane = 'changes';
      var timers = [];
      var userTouched = false;

      function later(ms, fn) { if (reduced) { fn(); return; } timers.push(setTimeout(fn, ms)); }
      function clearTimers() { timers.forEach(clearTimeout); timers = []; }

      // ── rendering ───────────────────────────────────────────────────────
      function statusOf(s) {
        if (s.state === 'draft') return { cls: 'idle', t: 'Not started' };
        if (s.state === 'plan' || s.state === 'gate' || s.state === 'ask') return { cls: 'you', t: 'Waiting on you' };
        if (s.state === 'done') return { cls: 'done', t: 'Done' };
        return { cls: 'run', t: s.who + ' working' };
      }
      function renderRail() {
        var needs = 0;
        sessionsEl.innerHTML = ORDER.map(function (id) {
          var s = S[id], st = statusOf(s);
          if (st.cls === 'you') needs++;
          return '<button type="button" role="tab" class="ide-sess' + (id === cur ? ' is-on' : '') + '" aria-selected="' + (id === cur) +
            '" data-act="open" data-id="' + id + '"><span class="dot dot--' + st.cls + '" aria-hidden="true"></span>' +
            '<span class="ide-sess-t">' + esc(s.title) + '</span><span class="ide-sess-s">' + esc(st.t) + '</span></button>';
        }).join('');
        needsEl.textContent = String(needs);
      }
      function renderSteps() {
        var s = S[cur];
        stepsEl.innerHTML = STEPS.map(function (name, i) {
          var cls = i < s.steps ? 'done' : (i === s.steps && s.state !== 'draft' && s.state !== 'done' ? 'now' : '');
          return '<li class="' + cls + '">' + name + '</li>';
        }).join('');
        titleEl.textContent = s.title;
      }
      function bubble(m) {
        if (m.k === 'user') return '<div class="msg msg--user"><p>' + esc(m.t) + '</p></div>';
        if (m.k === 'event') return '<p class="msg-event">' + m.t + '</p>';
        if (m.k === 'working') return '<p class="msg-working" data-working><span class="pulse" aria-hidden="true"></span>' + esc(m.t) + '</p>';
        var head = '<span class="msg-who">' + esc(m.who) + '</span>';
        if (m.k === 'agent') {
          var chips = m.chips ? '<div class="msg-chips">' + m.chips.map(function (c) {
            var act = c === 'Changes' ? 'changes' : (c === 'Evidence' ? 'receipt' : '');
            return act ? '<button type="button" class="chip" data-act="pane" data-pane="' + act + '">' + c + '</button>' : '<span class="chip chip--pr">' + c + '</span>';
          }).join('') + '</div>' : '';
          return '<div class="msg msg--agent' + (m.done ? ' msg--done' : '') + '">' + head + '<p>' + m.t + '</p>' + chips + '</div>';
        }
        if (m.k === 'plan') {
          var items = '<ol class="plan">' + m.items.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ol>';
          var acts = m.state === 'open'
            ? '<div class="acts"><button type="button" class="btn-yes" data-act="plan-ok">Approve plan</button><button type="button" class="btn-q" data-act="plan-later">Not now</button></div>'
            : '<p class="decided">' + (m.state === 'ok' ? 'You approved the plan.' : 'Parked. Nothing has started.') + '</p>' +
              (m.state === 'later' ? '<div class="acts"><button type="button" class="btn-yes" data-act="plan-ok">Approve plan</button></div>' : '');
          return '<div class="msg msg--agent msg--card">' + head + '<p>Here is my plan. Nothing starts until you approve it.</p>' + items + acts + '</div>';
        }
        if (m.k === 'gate') {
          var body;
          if (m.state === 'open') {
            body = '<div class="acts"><button type="button" class="btn-yes" data-act="gate-ok">Approve</button>' +
              '<button type="button" class="btn-q" data-act="gate-note">Approve with a note for the next step</button>' +
              '<button type="button" class="btn-q" data-act="gate-back">Send back</button></div>';
          } else if (m.state === 'noting') {
            body = '<div class="note-row"><input type="text" data-note aria-label="Your note for the next step" value="Track per-key limits in a follow-up issue." />' +
              '<button type="button" class="btn-yes" data-act="gate-note-send">Approve with note</button></div>';
          } else {
            body = '<p class="decided">' + esc(m.decided) + '</p>';
          }
          return '<div class="msg msg--agent msg--card msg--gate">' + head + '<p>' + m.t + '</p><p class="held">This step is held for you.</p>' + body + '</div>';
        }
        if (m.k === 'ask') {
          var ans = m.ans === null
            ? '<div class="acts">' + m.opts.map(function (o, i) { return '<button type="button" class="' + (i === 0 ? 'btn-yes' : 'btn-q') + '" data-act="answer" data-i="' + i + '">' + esc(o) + '</button>'; }).join('') + '</div>'
            : '<p class="decided">You answered: ' + esc(m.opts[m.ans]) + '</p>';
          return '<div class="msg msg--agent msg--card msg--ask"><span class="msg-who">' + esc(m.who) + ' · is asking</span><p>' + esc(m.q) + '</p>' + ans + '</div>';
        }
        return '';
      }
      function renderThread(keepScroll) {
        var s = S[cur];
        if (!s.msgs.length) {
          threadEl.innerHTML = '<div class="empty"><p><b>New job.</b> Say what you want in plain words. You get a plan to approve before anything starts.</p></div>';
        } else {
          threadEl.innerHTML = s.msgs.map(bubble).join('');
        }
        if (!keepScroll) threadEl.scrollTop = threadEl.scrollHeight;
      }
      function renderPane() {
        var s = S[cur];
        root.querySelectorAll('[data-pane-tab]').forEach(function (b) {
          var on = b.getAttribute('data-pane-tab') === pane;
          b.classList.toggle('is-on', on); b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        filesEl.textContent = String(s.files.length);
        if (pane === 'changes') {
          if (!s.files.length) {
            paneEl.innerHTML = '<p class="pane-empty">Nothing changed yet. Files show up here as the agents write them.</p>';
            return;
          }
          var f = s.files[Math.min(s.openFile, s.files.length - 1)];
          paneEl.innerHTML = '<ul class="files">' + s.files.map(function (x, i) {
            return '<li><button type="button" class="file' + (x === f ? ' is-on' : '') + '" data-act="file" data-i="' + i + '"><span>' + esc(x.path) + '</span>' +
              '<span class="n"><i class="a">+' + x.add + '</i> <i class="d">−' + x.del + '</i></span></button></li>';
          }).join('') + '</ul><pre class="diff" aria-label="Diff of ' + esc(f.path) + '">' + f.diff.map(function (l) {
            return '<span class="dl dl--' + (l[0] === '+' ? 'a' : l[0] === '-' ? 'd' : 'c') + '">' + esc(l[0] + ' ' + l[1]) + '</span>';
          }).join('') + '</pre>';
        } else {
          var r = s.receipt;
          if (!r) { paneEl.innerHTML = '<p class="pane-empty">The receipt fills in as the job runs: what was required, what ran, and who checked it.</p>'; return; }
          paneEl.innerHTML = '<table class="rc"><tbody>' +
            '<tr><th>Required</th><td>tests pass, a different agent reviews</td></tr>' +
            '<tr><th>Built by</th><td>' + esc(r.built) + '</td></tr>' +
            '<tr><th>Reviewed by</th><td>' + esc(r.reviewed || 'pending') + (r.reviewed ? ' <span class="ok">separate agent</span>' : '') + '</td></tr>' +
            '<tr><th>Tests</th><td>' + esc(r.tests || 'pending') + '</td></tr>' +
            '<tr><th>Decision</th><td>' + esc(r.decision || 'pending') + '</td></tr>' +
            '<tr><th>Skipped</th><td>nothing</td></tr></tbody></table>';
        }
      }
      function renderAll(keepScroll) { renderRail(); renderSteps(); renderThread(keepScroll); renderPane(); }
      function refresh(id) { if (id === cur) renderAll(); else renderRail(); }

      // ── the scripted run (job "rate") ───────────────────────────────────
      function push(id, m) { var s = S[id]; s.msgs = s.msgs.filter(function (x) { return x.k !== 'working'; }); if (m) s.msgs.push(m); refresh(id); }
      function work(id, text) { push(id, { k: 'working', t: text }); }

      function start(text) {
        var s = S.rate;
        s.state = 'plan-wait';
        push('rate', { k: 'user', t: text });
        if (text !== PROMPT) push('rate', { k: 'event', t: 'This demo replays one recorded job: rate limits for the public API.' });
        work('rate', 'Claude Code is planning…');
        later(1100, function () {
          s.state = 'plan';
          push('rate', { k: 'plan', who: 'Claude Code', state: 'open', items: [
            'Build: add a rate-limit middleware to the public routes',
            'Review: <b>Codex</b> checks it, not me',
            'Test: run the suite',
            'Deliver: open a pull request'] });
        });
      }
      function planDecision(ok) {
        var s = S.rate, plan = s.msgs.filter(function (m) { return m.k === 'plan'; })[0];
        if (!plan) return;
        plan.state = ok ? 'ok' : 'later';
        if (!ok) { refresh('rate'); return; }
        s.state = 'run'; s.steps = 1; s.receipt = { built: 'Claude Code' };
        work('rate', 'Working on Build…');
        later(1500, function () {
          s.files = FILES_V1; s.openFile = 0;
          push('rate', { k: 'agent', who: 'Claude Code', t: 'Build done. Added a rate-limit middleware and put it in front of the public routes, with a test. 3 files changed.', chips: ['Changes'] });
          s.steps = 2;
          work('rate', 'Codex is reviewing…');
          later(1400, function () {
            s.state = 'gate';
            push('rate', { k: 'gate', who: 'Codex', state: 'open', t: 'One finding: the limit is keyed on the client IP, but you asked for a limit <b>per API key</b>. Clients behind one proxy would share a limit.' });
          });
        });
      }
      function finish(decision, finalText) {
        var s = S.rate;
        s.state = 'run'; s.steps = 3;
        work('rate', 'Working on Test…');
        later(1200, function () {
          s.receipt.tests = '38 pass';
          push('rate', { k: 'event', t: 'Tests pass (38).' });
          s.steps = 4;
          work('rate', 'Working on Deliver…');
          later(900, function () {
            s.state = 'done'; s.steps = 5; s.receipt.decision = decision;
            push('rate', { k: 'agent', who: 'Claude Code', done: true, t: finalText, chips: ['Pull request #12', 'Changes', 'Evidence'] });
          });
        });
      }
      function gateDecision(kind, note) {
        var s = S.rate, gate = s.msgs.filter(function (m) { return m.k === 'gate'; }).pop();
        if (!gate || (gate.state !== 'open' && gate.state !== 'noting')) return;
        if (kind === 'note-open') { gate.state = 'noting'; refresh('rate'); var n = threadEl.querySelector('[data-note]'); if (n) { n.focus(); n.select(); } return; }
        s.receipt.reviewed = 'Codex';
        if (kind === 'ok') {
          gate.state = 'done'; gate.decided = 'You approved over the finding. That is on the record as your call.';
          finish('approved by you over a review finding', 'Done. Tests pass (38). You approved over Codex’s finding, and the receipt says so. Pull request #12 is open.');
        } else if (kind === 'note') {
          gate.state = 'done'; gate.decided = 'You approved. Your note goes to the next step: “' + note + '”';
          finish('approved by you, with a note', 'Done. Tests pass (38). You approved with a note, and it rides with the delivery. Pull request #12 is open.');
        } else if (kind === 'back') {
          gate.state = 'done'; gate.decided = 'You sent it back to Claude Code with the finding.';
          s.state = 'run'; s.steps = 1;
          work('rate', 'Working on Build…');
          later(1400, function () {
            s.files = FILES_V2;
            push('rate', { k: 'agent', who: 'Claude Code', t: 'Fixed. The limit is now per API key, with the client IP only for requests that carry no key.', chips: ['Changes'] });
            s.steps = 2;
            work('rate', 'Codex is reviewing…');
            later(1200, function () {
              push('rate', { k: 'agent', who: 'Codex', t: 'Approved. Keyed on the API key now, and the new test covers two keys.' });
              finish('approved by Codex after one send-back', 'Done. Tests pass (38), and codex reviewed and approved it. Pull request #12 is open.');
            });
          });
        }
      }
      function answer(i) {
        var s = S.flaky, ask = s.msgs.filter(function (m) { return m.k === 'ask'; })[0];
        if (!ask || ask.ans !== null) return;
        ask.ans = i; s.state = 'run'; s.receipt = { built: 'Codex' };
        work('flaky', 'Working on Build…');
        later(1400, function () {
          s.files = [{ path: 'test/checkout.test.ts', add: 4, del: 1, diff: i === 0
            ? [['-', '  const now = new Date();'], ['+', "  vi.setSystemTime(new Date('2026-01-01T23:59:30Z'));"], ['+', '  const now = new Date();']]
            : [['-', '  const now = new Date();'], ['+', '  const now = clock.now();']] }];
          s.steps = 2;
          push('flaky', { k: 'agent', who: 'Codex', t: 'Build done. Claude Code reviews it next.', chips: ['Changes'] });
          s.who = 'Claude Code';
          work('flaky', 'Claude Code is reviewing…');
        });
      }

      // ── input ───────────────────────────────────────────────────────────
      root.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('[data-act], [data-pane-tab]') : null;
        if (!b || b.disabled) return;
        userTouched = true;
        if (b.hasAttribute('data-pane-tab')) { pane = b.getAttribute('data-pane-tab'); renderPane(); return; }
        var a = b.getAttribute('data-act');
        if (a === 'open') { cur = b.getAttribute('data-id'); renderAll(); }
        else if (a === 'restart') { clearTimers(); S.rate = fresh().rate; cur = 'rate'; pane = 'changes'; input.value = PROMPT; renderAll(); input.focus(); }
        else if (a === 'plan-ok') planDecision(true);
        else if (a === 'plan-later') planDecision(false);
        else if (a === 'gate-ok') gateDecision('ok');
        else if (a === 'gate-back') gateDecision('back');
        else if (a === 'gate-note') gateDecision('note-open');
        else if (a === 'gate-note-send') { var n = threadEl.querySelector('[data-note]'); gateDecision('note', (n && n.value.trim()) || 'no note'); }
        else if (a === 'answer') answer(parseInt(b.getAttribute('data-i'), 10));
        else if (a === 'pane') { pane = b.getAttribute('data-pane'); renderPane(); }
        else if (a === 'file') { S[cur].openFile = parseInt(b.getAttribute('data-i'), 10); renderPane(); }
      });
      threadEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && e.target.matches && e.target.matches('[data-note]')) { e.preventDefault(); gateDecision('note', e.target.value.trim() || 'no note'); }
      });
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        userTouched = true;
        var text = input.value.trim();
        if (!text) return;
        var s = S[cur];
        if (cur === 'rate' && s.state === 'draft') { input.value = ''; start(text); return; }
        input.value = '';
        push(cur, { k: 'user', t: text });
        push(cur, { k: 'event', t: 'Note added. It goes to the agent with the next step.' });
      });

      renderAll();
      // Start the job on its own once the demo is on screen, unless the visitor got there first.
      // It always stops at the plan: nothing runs without a person approving it.
      function autoStart() { if (!userTouched && S.rate.state === 'draft') { input.value = ''; start(PROMPT); } }
      if (reduced) { autoStart(); return; }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          if (es.some(function (x) { return x.isIntersecting; })) { io.disconnect(); setTimeout(autoStart, 900); }
        }, { threshold: 0.4 });
        io.observe(root);
      } else { autoStart(); }
    })();
  </script>
</Base>
