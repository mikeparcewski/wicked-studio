          <table class="hits" aria-label="One search across three repos (an example)" data-queries={JSON.stringify(QUERIES)}>
            <caption><code data-q-cap>{QUERIES[0].q}</code> across one project: <span data-total>{QUERIES[0].n.reduce((a, b) => a + b, 0)}</span> hits</caption>
            <tbody>
              {HITS.map((h) => (
                <tr><th scope="row">{h.repo}</th><td class="hits-n" data-n={h.n}>{h.n}</td><td class="hits-bar" aria-hidden="true"><i style={`--w:${h.n / 4}`}></i></td><td>{h.lang}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="reach-limit">Each hit names its repo. Calls between repos are not traced, and every answer says so.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 7. What's new in 0.16 ─────────────────────────────────────────────── */}
  <section class="new frame snap-section" id="new" aria-labelledby="new-h" data-autoplay>
    <div class="wrap">
      <div class="sec-head sec-head--row">
        <div>
          <h2 id="new-h">What’s new in 0.16</h2>
        </div>
        <button type="button" class="play-toggle" data-play-toggle aria-pressed="false" aria-label="Pause the tour of what is new"><span class="pt-ic" aria-hidden="true"></span><span class="pt-l" aria-hidden="true"><span class="pt-pause">Pause</span><span class="pt-play">Play</span></span></button>
      </div>
      <div class="news" data-tour data-tour-ms="4500">
        <div class="news-tabs" role="tablist" aria-label="What is new in 0.16" data-news-row>
          {NEW.map((n, k) => (
            <button type="button" role="tab" class={`news-tab${k === 0 ? ' is-on' : ''}`} id={`new-tab-${k}`} aria-controls={`new-panel-${k}`} aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? '0' : '-1'}>{n.tab}</button>
          ))}
        </div>
        <div class="news-stage">
          {NEW.map((n, k) => (
            <div class={`news-panel ex-panel${k === 0 ? ' is-on' : ''}`} role="tabpanel" id={`new-panel-${k}`} aria-labelledby={`new-h3-${k}`}>
              <div class="news-copy">
                <span class="news-n" aria-hidden="true">{String(k + 1).padStart(2, '0')} / {String(NEW.length).padStart(2, '0')}</span>
                <h3 id={`new-h3-${k}`}>{n.name}</h3>
                {n.lead && <p>{n.lead}</p>}
                <p class={n.lead ? 'news-sub' : undefined}>{n.line}</p>
                {n.more && <p class="news-sub">{n.more}</p>}
              </div>
              <div class="ex-art news-art" aria-hidden="true">
                {k === 0 && (
                  <div class="art art-catalog art-docs">
                    <div class="av-bar"><span class="av-text">answer this RFP from our security docs</span></div>
                    <div class="al-row"><b>Documents</b><span>rfp-acme.pdf · security-faq.md</span></div>
                    <div class="al-row"><b>Job</b><span>Respond to an RFP</span></div>
                    <p class="aa-read">Fidelity check: every answer traces to a document</p>
                  </div>
                )}
                {k === 1 && (
                  <div class="art art-sources art-pick">
                    <div class="av-bar"><span class="av-text">compare our pricing with our top three rivals</span></div>
                    <div class="al-row"><b>Reading</b><span class="as-chip">the web</span><span class="as-chip">support-pg</span></div>
                    <div class="al-row"><b>Can’t pick</b><span class="as-chip">billing-mysql</span><span>Agents can’t query it</span></div>
                    <p class="aa-read">Every step queries only these data sources</p>
                  </div>
                )}
                {k === 2 && (
                  <div class="art art-apps art-cited">
                    <span class="tk-k">Competitive report</span>
                    <div class="au-a">C1 Two of the three price per seat. <span class="au-cite">src: rival-a.example/pricing</span></div>
                    <div class="au-a">C2 One has a free tier. <span class="au-cite">src: rival-b.example/plans</span></div>
                    <p class="aa-read">Check: each claim re-read at its source</p>
                  </div>
                )}
                {k === 3 && (
                  <div class="art art-catalog art-review">
                    <div class="av-bar"><span class="av-text">/review-change github.com/acme/api/pull/412</span></div>
                    <div class="al-row"><b>Verdict</b><span>Conditional · 2 findings, each cited</span></div>
                    <div class="al-row"><b>Judged by</b><span>agents that wrote none of it</span></div>
                    <p class="aa-read">Nothing posted to the pull request</p>
                  </div>
                )}
                {k === 4 && (
                  <div class="art art-catalog art-publish">
                    <span class="tk-k">Publish · Support desk</span>
                    <div class="al-row"><b>Who sees it</b><span>Signed-in viewers · support group</span></div>
                    <div class="al-row"><b>Before</b><span>Check · QE · your consent</span></div>
                    <pre class="ak-sql">docker run -p 8080:8080 support-desk:v3</pre>
                  </div>
                )}
                {k === 5 && (
                  <div class="art art-catalog art-plugin">
                    <div class="av-bar"><span class="av-text">/plugin phase list each phase as it starts and ends</span></div>
                    <div class="km-wait"><span>Install: approve each event topic it reads</span><span class="s-btn s-btn--yes">Approve</span></div>
                    <div class="al-row"><b>Details</b><span>From plugin · phase log</span></div>
                  </div>
                )}
                {k === 6 && (
                  <div class="art art-catalog art-cost">
                    <div class="av-bar"><span class="av-text">what would 40 bug fixes a month cost?</span></div>
                    <div class="al-row"><b>From</b><span>your bug-fix runs, last 90 days</span></div>
                    <div class="ac-app"><span class="ax-bars"><i style="--h:.55"></i><i style="--h:.72"></i><i style="--h:.95"></i></span><span class="ak-note">median · p75 · p90</span></div>
                  </div>
                )}
                {k === 7 && (
                  <div class="art art-catalog art-demo">
                    <span class="tk-k">Demo video · review gate</span>
                    <div class="al-row"><b>Reviewed</b><span>1 finding · 3 contact sheets</span></div>
                    <div class="al-row"><b>Then</b><span>Record it again · Edit the cut · Export</span></div>
                  </div>
                )}
              </div>
            </div>
          ))}
          <div class="ex-progress" aria-hidden="true"><i data-tour-bar></i></div>
        </div>
      </div>
    </div>
  </section>

  <SameGarden current="wicked-studio" />

  {/* ── 9. Get it ─────────────────────────────────────────────────────────── */}
  <div class="finale">
    <section class="get frame snap-section" id="get" aria-labelledby="get-h">
      <div class="wrap get-grid">
        <div class="get-intro">
          <h2 id="get-h">One command. Studio comes with it.</h2>
          <p>
            <code>npx wicked-crew serve</code> starts the daemon and serves studio on one port. Open the
            URL it prints, sign in your agents, and start a job.
          </p>
          <ul class="needs" role="list">
            <li>Node 22 or later (24.12, 25.1 or later to upload files as data sources)</li>
            <li>A container runtime: Docker, Podman, Rancher Desktop, Colima or OrbStack</li>
            <li>wicked-garden 12.66.0 or later, for the skills every agent follows</li>
            <li>The whole family instead? <code>npx wicked-installer</code></li>
          </ul>
        </div>
        <div class="install-stack">
          <div class="install install--primary" role="group" aria-label="Run studio bundled with wicked-crew">
            <div class="install__bar">
              <span class="install__label"><span class="install__star" aria-hidden="true">★</span> Recommended</span>
              <button class="install__copy" type="button" aria-label="Copy the bundled serve command" data-copy="npx wicked-crew serve"><span data-copy-label>Copy</span></button>
            </div>
            <pre class="install__code"><code data-typed="npx wicked-crew serve">npx wicked-crew serve</code></pre>
            <p class="install__note">Daemon and studio, one port. <span class="install__ver">wicked-studio v{studioVersion}</span></p>
          </div>

          <div class="install install--secondary" role="group" aria-label="Run wicked-studio standalone against a daemon">
            <div class="install__bar">
              <span class="install__label">Or host studio yourself</span>
              <button class="install__copy" type="button" aria-label="Copy the standalone build commands" data-copy={'VITE_API_HOST=127.0.0.1:7701 npm run build\nnpx serve dist'}><span data-copy-label>Copy</span></button>
            </div>
            <pre class="install__code"><code>VITE_API_HOST=127.0.0.1:7701 npm run build
npx serve dist</code></pre>
            <p class="install__note">Studio is a pure client of crew’s <code>/api/v1</code> and <code>/ws</code>. It shares no code with crew beyond the published contract, <code>wicked-crew-api-types</code>.</p>
          </div>
        </div>
        <a class="gh-pill" href="https://github.com/mikeparcewski/wicked-studio#readme" target="_blank" rel="noopener" aria-label="View wicked-studio on GitHub">
          <svg viewBox="0 0 16 16" width="34" height="34" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </section>

    <Footer repo={repo} />
  </div>

  <span class="sr-only" role="status" data-copy-status></span>

