{
  "name": "wicked-studio",
  "version": "0.11.8",
  "description": "Where you direct your coding agents: start a job with a chat, sign your agents in once, watch them work in sandboxes, and approve what matters with the evidence. The browser UI for wicked-crew.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-studio.git"
  },
  "homepage": "https://github.com/mikeparcewski/wicked-studio#readme",
  "bugs": {
    "url": "https://github.com/mikeparcewski/wicked-studio/issues"
  },
  "keywords": [
    "wicked-crew",
    "hitl",
    "agent-orchestration",
    "react",
    "spa"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "manifest:testids": "node scripts/generate-testid-inventory.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare-dist.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "diff": "^9.0.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shell-quote": "^1.12.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/shell-quote": "^1.7.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.2",
    "wicked-crew-api-types": "0.128.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
