# Dev-only (:4200 split, DES-STUDIO-SERVING-001 §4.2). Vite loads this for the
# `vite` dev server; it points REST + WS at the daemon on 127.0.0.1:7701 while
# the SPA itself is served from :4200 (loopback-CORS path on the daemon).
# Prod builds do NOT load this file, so the resolver falls back to
# window.location (same-origin). Do not set this in production.
VITE_API_HOST=127.0.0.1:7701
